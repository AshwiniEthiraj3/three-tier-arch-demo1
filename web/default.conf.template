# STATIC WEB
server {
  listen 8080;
  server_name _;

  root  /usr/share/nginx/html;
  index index.html;

  # ALB health check
  location = /healthz { return 200; }

  # Serve SPA/static pages
  location / {
    try_files $uri $uri/ /index.html;
  }

  # ---- API BACKENDS (ECS service discovery names) ----
  # Only keep the ones you actually have running in ECS

  location /catalogue/ {
    proxy_pass http://$CATALOGUE_HOST/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /user/ {
    proxy_pass http://$USER_HOST/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /cart/ {
    proxy_pass http://$CART_HOST/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /shipping/ {
    proxy_pass http://$SHIPPING_HOST/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /payment/ {
    proxy_pass http://$PAYMENT_HOST/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /ratings/ {
    proxy_pass http://$RATINGS_HOST/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
